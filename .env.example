# Copy to .env and edit. Every application setting uses the AIJP_ prefix and has a default in
# app/config.py, so only set what you want to change. Never commit the real .env file.

# ---- database ---------------------------------------------------------------------------------
# Used by docker compose for the bundled database (and to build the API's connection string).
POSTGRES_PASSWORD=change-me
# Used when running the API outside compose (uv run uvicorn ...).
AIJP_DATABASE_URL=postgresql+psycopg://aijp:aijp@127.0.0.1:5432/aijp

# ---- Ollama (embeddings + answer model) ---------------------------------------------------------
AIJP_OLLAMA_BASE_URL=http://127.0.0.1:11434
AIJP_EMBEDDING_MODEL=nomic-embed-text
AIJP_EMBEDDING_DIM=768
AIJP_LLM_MODEL=qwen3.5

# ---- ingestion --------------------------------------------------------------------------------
AIJP_MAX_UPLOAD_BYTES=10485760
AIJP_CHUNK_MAX_CHARS=1200
AIJP_CHUNK_OVERLAP_CHARS=150

# ---- retrieval and refusal --------------------------------------------------------------------
AIJP_RETRIEVAL_MODE=vector          # vector | lexical | hybrid
AIJP_ASK_TOP_K=5
AIJP_MIN_EVIDENCE_SCORE=0.55        # evidence gate for /ask; calibrated in eval/results
AIJP_CONSISTENCY_TOP_K=4
AIJP_CONSISTENCY_MIN_COSINE=0.60    # evidence gate for the consistency check
AIJP_RERANK_ENABLED=false           # reorder the top candidates with one extra model call (+~2 s)
AIJP_RERANK_POOL=10                 # how many candidates the reranker sees
AIJP_LLM_THINK=false                # let the answer model reason first: better answers, ~6x slower
AIJP_ASK_CALCULATOR=false           # NOT recommended: measured worse with the local model

# ---- observability ----------------------------------------------------------------------------
AIJP_LOG_LEVEL=INFO
AIJP_LOG_FORMAT=plain               # plain for a terminal, json for containers/log shippers
AIJP_METRICS_ENABLED=true           # /metrics needs a reader key when authentication is on

# ---- authentication ---------------------------------------------------------------------------
# ON by default. Create keys with: python -m app.keys create --name alice --role editor
# Set to false ONLY on a machine nobody else can reach (the server logs a loud warning).
AIJP_AUTH_ENABLED=true
